# Bigg Boss Season 20 — 24x7 YouTube Live — Configuration Template
# Copy this file to .env and fill in your actual credentials.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=your-youtube-stream-key
YOUTUBE_VIDEO_ID=your-video-id
SOCIALCOUNTS_VIDEO_ID=your-video-id
YOUTUBE_CHANNEL_ID=your-channel-id
ADMIN_CHANNEL_IDS=your-channel-id

# Dynamic YouTube Video ID resolution
FETCH_DYNAMIC_VIDEO_ID=true
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_LIVE_TITLE="Bigg Boss Live Stream | Vote your favorite contestant #bigboss #biggboss"

# Video / Audio Encoding
STREAM_RESOLUTION=720x1280
RENDER_RESOLUTION=720x1280
FPS=30
RENDER_FPS=30
RENDER_WORKERS=4
BITRATE=2500k
VIDEO_CODEC=libx264
PRESET=ultrafast
ENCODER_THREADS=0
GOP_SECONDS=2
VIDEO_FEED_FORMAT=raw
AUDIO_FILE=
AUDIO_VOLUME=0.15
BACKGROUND_IMAGE=assets/bb20_bg.jpg

# Interactive / Commands
VOTE_COMMAND=!vote
ALLOW_VIEWER_STATUS=true
PUBLIC_THEME_COMMANDS=true
PUBLIC_MUSIC_COMMANDS=true
PUBLIC_SCREEN_COMMANDS=true
SCREEN_INTERVAL_MS=20000
SCREEN_TRANSITION_MS=500
